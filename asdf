<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Matter.js Minimal Boilerplate</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      overflow: hidden;
      background-color: #111;
    }
  </style>
</head>
<body>

  <!-- Matter.js Library via CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/matter-js/0.20.0/matter.min.js"></script>

  <script>
    // 1. Module aliases
    const { Engine, Render, Runner, Bodies, Composite } = Matter;

    // 2. Create an engine
    const engine = Engine.create();
    const idealBoxSize = 20
    let substeps = 10
    const boxSize = window.innerWidth/Math.floor(window.innerWidth/idealBoxSize)
    // 3. Create a renderer
    const render = Render.create({
      element: document.body,
      engine: engine,
      options: {
        width: window.innerWidth,
        height: window.innerHeight,
        wireframes: false
      }
    });

    let bodies = []
    function createBorders() {
      let borderDepth = 10000
      Composite.add(engine.world, [
        Bodies.rectangle(
          window.innerWidth / 2, 
          window.innerHeight + borderDepth / 2, 
          window.innerWidth, 
          borderDepth, 
          { isStatic: true }
        ),
        Bodies.rectangle(
          window.innerWidth / 2, 
          -borderDepth / 2, 
          window.innerWidth, 
          borderDepth, 
          { isStatic: true }
        ),
        Bodies.rectangle(
          -borderDepth / 2,
          window.innerHeight / 2,
          borderDepth,
          window.innerHeight,
          { isStatic: true }
        ),
        Bodies.rectangle(
          window.innerWidth + borderDepth / 2,
          window.innerHeight / 2,
          borderDepth,
          window.innerHeight,
          { isStatic: true }
        )
      ])
    }
    createBorders()
    function createFloor() {
      for (let i = 0; i < window.innerWidth/boxSize; i++) {
        for (let j = 0; j < 10; j++) {
          bodies.push(Bodies.rectangle(
            i*boxSize + boxSize/2,
            window.innerHeight - boxSize/2 - boxSize * j,
            boxSize, boxSize, {
              friction: 0,
              density: 0.1,
            }
          ))
        }
      }
    }
    function explosion(x, y, radius, force) {
      for (let body of bodies) {
        let distanceX = (x - body.position.x)
        let distanceY = (y - body.position.y)
        let distance = Math.sqrt(distanceX ** 2 + distanceY ** 2)
        if (distance > radius) continue
        let currForce = force * (1 - (distance/radius))
        Matter.Body.setVelocity(body, {
          x: body.velocity.x + distanceX / distance * currForce,
          y: body.velocity.y + distanceY / distance * currForce,
        })
      }
    }
    createFloor()
    explosion(window.innerWidth,window.innerHeight,100,100)
    // 5. Add all bodies to the world composite
    Composite.add(engine.world, bodies);

    // 6. Run both the renderer and the engine
    Render.run(render);
    let simulationHz = Math.floor(1000/60)*60
    const runner = Runner.create({
      isFixed: true,             // Forces a fixed physics step size
      delta: 1000 / simulationHz
    })
    function animate() {
      for (let i = 0; i < simulationHz/60; i++) {
        Matter.Engine.update(engine, 1000/simulationHz)
      }
      requestAnimationFrame(animate)
    }

    requestAnimationFrame(animate)
  </script>
</body>
</html>
